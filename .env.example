# Copy to .env before running docker compose up.

FLASK_ENV=development

# Generate real values: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
JWT_SECRET_KEY=dev-insecure-change-me

POSTGRES_USER=webguard
POSTGRES_PASSWORD=webguard
POSTGRES_DB=webguard

# Host port mappings — change if something already occupies these locally.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=5000

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

CORS_ORIGINS=http://localhost:5173

MIN_INTERVAL_SECONDS=60
MAX_MONITORS_PER_ORG=100

# Set false to start the API without running `flask db upgrade` first.
RUN_MIGRATIONS=true

# Public recursive resolvers for the DNS posture engine. Docker's embedded
# resolver cannot answer CAA/DNSKEY, so these must not be left to resolv.conf.
DNS_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9

# --- Alerting (Phase 3) ---
# Leave SENDGRID_API_KEY empty to disable email; Slack/Discord/webhook still work.
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_FROM_NAME=WebGuard ScanPulse

# Consecutive failed probes before an incident opens. Floor is 2 (anti-flapping).
DEFAULT_FAILURE_THRESHOLD=2

# Days-remaining marks that trigger a certificate expiry alert.
SSL_EXPIRY_THRESHOLDS=30,14,7,3,1
